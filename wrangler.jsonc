{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "series-hub",
  "main": "./src/phase4-worker.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUSH_SUBSCRIPTIONS_ENABLED": "true",
    "EPISODE_REMINDERS_ENABLED": "false"
  },
  "secrets": {
    "required": [
      "TMDB_API_TOKEN"
    ]
  },
  "triggers": {
    "crons": [
      "7 * * * *",
      "17 */6 * * *",
      "47 */6 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "series-hub-db",
      "database_id": "531edf79-942a-4ff8-9dcb-eaea861a1a69",
      "migrations_dir": "migrations"
    }
  ]
}
