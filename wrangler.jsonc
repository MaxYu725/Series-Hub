{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "series-hub",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "17 */6 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "series-hub-db",
      "database_id": "531edf79-942a-4ff8-9dcb-eaea861a1a69",
      "migrations_dir": "migrations"
    }
  ]
}
