{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "series-hub-push-spike",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/send-test"
    ]
  },
  "vars": {
    "VAPID_PUBLIC_KEY": "generated-by-ci",
    "VAPID_SUBJECT": "https://series-hub.max-yu-jp.workers.dev"
  }
}
